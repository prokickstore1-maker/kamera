{
  "name": "vintaagemeew",
  "description": "Production Coolify deployment specification for vintaagemeew",
  "build_pack": "dockerfile",
  "dockerfile_location": "/Dockerfile",
  "ports_exposes": "3000",
  "environment_variables": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "DATABASE_URL",
      "value": "postgresql://postgres:password@postgres:5432/vintaagemeew_db",
      "is_build_time": false
    },
    {
      "key": "NEXT_PUBLIC_SITE_URL",
      "value": "https://vintaagemeew.com",
      "is_build_time": true
    },
    {
      "key": "ADMIN_PASSWORD_HASH",
      "value": "$2b$10$replace_with_bcrypt_hash",
      "is_build_time": false
    },
    {
      "key": "ADMIN_SESSION_SECRET",
      "value": "min_32_characters_random_secret_key_here",
      "is_build_time": false
    },
    {
      "key": "CRON_SECRET",
      "value": "min_32_characters_random_secret_key_here",
      "is_build_time": false
    },
    {
      "key": "TELEGRAM_BOT_TOKEN",
      "value": "",
      "is_build_time": false
    },
    {
      "key": "TELEGRAM_CHAT_ID",
      "value": "",
      "is_build_time": false
    },
    {
      "key": "S3_ENDPOINT",
      "value": "https://minio.yourdomain.com",
      "is_build_time": false
    },
    {
      "key": "S3_ACCESS_KEY_ID",
      "value": "",
      "is_build_time": false
    },
    {
      "key": "S3_SECRET_ACCESS_KEY",
      "value": "",
      "is_build_time": false
    },
    {
      "key": "S3_BUCKET_PUBLIC",
      "value": "vintaagemeew-public",
      "is_build_time": false
    },
    {
      "key": "S3_BUCKET_PRIVATE",
      "value": "vintaagemeew-proofs",
      "is_build_time": false
    }
  ],
  "health_check": {
    "enabled": true,
    "path": "/api/health",
    "port": "3000",
    "interval": 30,
    "timeout": 5,
    "retries": 3
  }
}

# Database PostgreSQL (Lokal / Neon / Supabase / Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vintaagemeew_db

# Admin Control Plane (Username: admin, Password default: admin123)
ADMIN_PASSWORD_HASH=$2b$10$Z82suZoBbsBeHqSRFRCrLebcCfmfAuojRqI5RX1rRWxDtiYRRQq7C
ADMIN_SESSION_SECRET=vintaagemeew-session-secret-key-32chars-min

# Cron Scheduler (Auto-Cancel Expired Orders)
CRON_SECRET=vintaagemeew-cron-secret-key-32chars-min

# Object Storage S3 / MinIO (Opsional saat browsing awal, wajib saat upload bukti bayar)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=vintaagemeew-public
S3_BUCKET_PRIVATE=vintaagemeew-private
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/vintaagemeew-public
